# Anthropic API key (or a compatible relay key)
ANTHROPIC_API_KEY=sk-...
# Optional: point at an Anthropic-compatible relay
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional semantic/hybrid code graph search.
# Set to 1 only after accepting that symbol metadata may be sent to the provider.
MINI_CLAUDE_ACCEPT_CLOUD_EMBEDDINGS=0
MINI_CLAUDE_EMBEDDING_BASE_URL=https://api.openai.com/v1
MINI_CLAUDE_EMBEDDING_MODEL=text-embedding-3-small
MINI_CLAUDE_EMBEDDING_API_KEY=
